{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 22, "patch": 0 },
  "configurePresets": [
    {
      "name": "windows-msvc",
      "displayName": "Windows MSVC (VS 18 2026)",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build"
    },
    {
      "name": "windows-ninja",
      "displayName": "Windows Ninja + cl (ejecutar desde VsDevCmd x64)",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build-ninja",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl"
      }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "windows-msvc", "configuration": "Debug" },
    { "name": "release", "configurePreset": "windows-msvc", "configuration": "Release" },
    { "name": "ninja-release", "configurePreset": "windows-ninja", "configuration": "Release" }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "windows-msvc",
      "configuration": "Debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "release",
      "configurePreset": "windows-msvc",
      "configuration": "Release",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "ninja-release",
      "configurePreset": "windows-ninja",
      "configuration": "Release",
      "output": { "outputOnFailure": true }
    }
  ]
}
